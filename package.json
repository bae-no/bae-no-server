{
  "name": "bae-no-server-new",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prebuild": "pnpm prisma:generate && rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "OTLP_TRACE=ture nest start --entryFile main",
    "console": "nest start --entryFile repl",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/app/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run unit",
    "test:integration": "vitest run integration --single-thread",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage",
    "test:ci": "pnpm test:ci-unit && pnpm test:ci-integration",
    "test:ci-unit": "pnpm test:unit --coverage.enabled --coverage.reportsDirectory=coverage-unit",
    "test:ci-integration": "pnpm test:integration --coverage.enabled --coverage.reportsDirectory=coverage-integration",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "graphql:schema": "vitest run AppModule.spec.ts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@effect-ts/core": "0.60.5",
    "@effect-ts/otel": "0.15.1",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.1",
    "@opentelemetry/api": "1.6.0",
    "@opentelemetry/auto-instrumentations-node": "0.39.2",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-jaeger": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.43.0",
    "@opentelemetry/instrumentation": "0.43.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.43.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.17.0",
    "@prisma/client": "7.9.1",
    "@prisma/instrumentation": "7.9.1",
    "bullmq": "^6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.0",
    "date-fns": "4.4.0",
    "firebase-admin": "14.2.0",
    "graphql": "17.0.2",
    "graphql-redis-subscriptions": "2.6.0",
    "graphql-subscriptions": "3.0.0",
    "ioredis": "^6.0.0",
    "passport": "0.6.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.1.13",
    "rimraf": "6.1.3",
    "rxjs": "7.8.1",
    "ulid": "^3.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@swc/core": "1.3.65",
    "@swc/helpers": "0.5.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "^8.5.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "10.8.1",
    "eslint-config-async": "3.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.28.1",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.0.0",
    "express": "5.2.1",
    "graphql-ws": "^6.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.0.0",
    "prisma": "7.9.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-loader": "9.4.3",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "7.0.2",
    "unplugin-swc": "1.4.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11",
    "vitest-mock-extended": "5.1.1",
    "ws": "^8.13.0"
  }
}
